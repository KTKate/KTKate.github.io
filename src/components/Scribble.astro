---
// Hand-drawn SVG marks, always in the accent color. Decorative unless a label is passed.
const { name, class: cls = '', label } = Astro.props;
const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' };
const stroke = { fill: 'none', stroke: 'currentColor', 'stroke-width': 2.5, 'stroke-linecap': 'round', 'stroke-linejoin': 'round' };
---
{name === 'squiggle' && <svg class={cls} viewBox="0 0 280 18" {...a11y}><path {...stroke} d="M3 11c18-8 32 7 50 3s26-10 44-4 30 11 50 2 28-9 48-3 36 6 50-1 24-6 32-2"/></svg>}
{name === 'arrow' && <svg class={cls} viewBox="0 0 48 32" {...a11y}><path {...stroke} d="M3 20c12-10 24-14 40-6M33 7l10 7-9 9"/></svg>}
{name === 'loop' && <svg class={cls} viewBox="0 0 300 90" preserveAspectRatio="none" {...a11y}><path {...stroke} d="M150 12c-70-6-140 10-140 36 0 24 60 34 140 32s138-14 136-38c-2-22-58-32-120-30-26 1-40 4-54 8"/></svg>}
{name === 'tick' && <svg class={cls} viewBox="0 0 40 40" {...a11y}><path {...stroke} d="M6 22c6 3 10 8 12 12 4-12 10-20 18-28"/></svg>}
