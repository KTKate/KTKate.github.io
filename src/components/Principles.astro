---
import { principles } from '../principles';
---
<section id="principles" class="principles" aria-labelledby="principles-title">
  <div class="wrap">
    <div class="section-head"><div><p class="kicker">Product principles</p><h2 id="principles-title">Three disciplines.<br/>A considered decision.</h2></div><p>How I use research, product thinking, and technical evaluation to decide what to build.</p></div>
    <div class="switcher" data-principles>
      <div class="tabs" aria-label="Principle groups">
        {principles.map((p,index) => <button id={`tab-${p.id}`} type="button" data-panel={`panel-${p.id}`} data-group={p.id}><span>{p.number}</span>{p.name}</button>)}
      </div>
      {principles.map(p => <section class="panel" id={`panel-${p.id}`} aria-labelledby={`tab-${p.id}`}><p class="panel-label">{p.name}</p><ol>{p.items.map(([title,detail]) => <li><h3>{title}</h3><p>{detail}</p></li>)}</ol></section>)}
    </div>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-principles]').forEach(root => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('button[data-panel]')];
    root.querySelector('.tabs')?.setAttribute('role','tablist');
    const select = (tab: HTMLButtonElement, focus = true) => {
      tabs.forEach(item => {
        const selected = item === tab;
        item.setAttribute('role','tab');
        item.setAttribute('aria-controls',item.dataset.panel!);
        item.setAttribute('aria-selected',String(selected));
        item.tabIndex = selected ? 0 : -1;
        const panel = root.querySelector<HTMLElement>(`#${item.dataset.panel}`)!;
        panel.setAttribute('role','tabpanel'); panel.tabIndex = 0; panel.hidden = !selected;
      });
      root.dataset.active = tab.dataset.group;
      if(focus) tab.focus();
    };
    tabs.forEach((tab,index) => {
      tab.addEventListener('click',()=>select(tab));
      tab.addEventListener('keydown',event=>{
        let next:number;
        if(event.key==='Home') next=0;
        else if(event.key==='End') next=tabs.length-1;
        else if(event.key==='ArrowRight') next=(index+1)%tabs.length;
        else if(event.key==='ArrowLeft') next=(index-1+tabs.length)%tabs.length;
        else return;
        event.preventDefault(); select(tabs[next]);
      });
    });
    select(tabs[0],false);
  });
</script>
<style>
.principles{padding:88px 0;background:#efedf5;border-block:1px solid #dedbe9}.switcher{border:1px solid #c7c2d8;background:var(--paper)}.tabs{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-bottom:1px solid #c7c2d8}.tabs button{border:0;border-right:1px solid #d7d3e3;border-top:4px solid transparent;background:transparent;text-align:left;padding:19px 24px;font-size:1rem;font-weight:750;color:var(--type);line-height:1.4}.tabs button:last-child{border-right:0}.tabs button>span{display:block;font-size:.875rem;font-weight:600;color:var(--type-2);margin-bottom:8px}.tabs button[aria-selected=true]{background:#eeebfb;border-top-color:var(--violet)}.tabs button[data-group=product][aria-selected=true]{background:#fff2d9;border-top-color:var(--amber)}.tabs button[data-group=technology][aria-selected=true]{background:#fce5f4;border-top-color:var(--magenta)}.tabs button:hover{background:#f0eef6}.panel{padding:32px 36px;min-height:250px}.panel-label{font-size:.875rem;font-weight:750;color:var(--accent);margin:0 0 20px}.panel ol{display:grid;grid-template-columns:1fr 1fr;gap:48px;list-style:none;padding:0;margin:0}.panel h3{font-size:1.6rem;line-height:1.25;margin:0 0 12px;max-width:24ch}.panel li p{color:var(--type-2);margin:0;max-width:45ch}
@media(max-width:700px){.principles{padding:60px 0}.tabs{grid-template-columns:repeat(2,minmax(0,1fr))}.tabs button{min-width:0;overflow-wrap:anywhere;padding:15px;font-size:.9375rem;border-bottom:1px solid #d7d3e3}.tabs button:nth-child(2){border-right:0}.panel{padding:26px 22px;min-height:0}.panel ol{grid-template-columns:1fr;gap:26px}.panel h3{font-size:1.4rem}.panel li+li{border-top:1px solid var(--line);padding-top:24px}}
@media print{.tabs{display:none}.panel{display:block!important;min-height:0;padding:16pt 0}.principles{padding:0;background:white;border:0}.panel ol{gap:20pt}.panel h3{font-size:12pt}}
</style>
