---
import { principles } from '../principles';
---
<section id="principles" class="section principles" aria-labelledby="principles-title">
  <div class="wrap">
    <div class="section-head">
      <div><span class="rule-num">04 · Operating rules</span><h2 id="principles-title">Eight rules, three disciplines.</h2></div>
      <p>Research, product, and technical evaluation each have their own rules. The decision happens where all three agree.</p>
    </div>
    <div class="rules">
      {principles.map(group => <section class="group" aria-labelledby={`group-${group.id}`}>
        <h3 id={`group-${group.id}`}><span class="gnum">{group.number}</span>{group.name}</h3>
        <ol>{group.items.map(([title, detail]) => <li><strong>{title}</strong><span>{detail}</span></li>)}</ol>
      </section>)}
    </div>
  </div>
</section>
<style>
.principles{background:var(--paper-2);border-bottom:1px solid var(--line)}
.rules{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0;border:1px solid var(--ink);background:var(--paper)}
.group{padding:22px 22px 26px;border-right:1px solid var(--ink)}.group:last-child{border-right:0}
.group h3{font-family:var(--mono);font-size:.8125rem;text-transform:uppercase;letter-spacing:.1em;font-weight:500;font-variation-settings:normal;margin:0 0 20px;display:flex;gap:12px;align-items:baseline;color:var(--ink-2)}
.gnum{color:var(--accent)}
.group ol{list-style:none;margin:0;padding:0;counter-reset:rule}
.group li{position:relative;padding:0 0 0 28px;margin-bottom:22px;counter-increment:rule}.group li:last-child{margin-bottom:0}
.group li::before{content:'';position:absolute;left:0;top:.35em;width:12px;height:12px;border:1px solid var(--ink);background:var(--paper)}
.group li::after{content:'';position:absolute;left:3px;top:calc(.35em + 3px);width:6px;height:6px;background:var(--accent)}
.group strong{display:block;font-family:var(--serif);font-weight:500;font-size:1.25rem;line-height:1.2;margin-bottom:6px;font-variation-settings:var(--wonk)}
.group span{color:var(--ink-2);font-size:.9375rem;line-height:1.5;display:block}
@media(max-width:1000px){.rules{grid-template-columns:repeat(2,minmax(0,1fr))}.group:nth-child(2){border-right:0}.group:nth-child(-n+2){border-bottom:1px solid var(--ink)}}
@media(max-width:600px){.rules{grid-template-columns:1fr}.group{border-right:0;border-bottom:1px solid var(--ink)}.group:last-child{border-bottom:0}}
@media print{.principles{background:white;border:0}.rules{grid-template-columns:repeat(2,minmax(0,1fr))}.group strong{font-size:11pt}.group span{font-size:9pt}}
</style>
