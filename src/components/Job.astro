---
import Scribble from './Scribble.astro';
import { principles } from '../principles';
---
<section class="band job" aria-labelledby="job-title">
  <div class="wrap">
    <h2 id="job-title">The job, in three parts.<Scribble name="squiggle" class="scribble" /></h2>
    <p class="lede">My title says design and research. The work is product and platform direction for IBM LinuxONE, and it always has the same three parts.</p>
    <ol class="parts">
      {principles.map((group, i) => <li class={`part part-${group.color}`}>
        <span class="part-icon"><Scribble name={group.icon} /></span>
        <h3><span class="part-n">{i + 1}.</span> {group.name}</h3>
        <ul>{group.items.map(item => <li>{item}</li>)}</ul>
      </li>)}
    </ol>
  </div>
</section>
<style>
.job h2{margin-bottom:12px}.job .lede{margin-bottom:clamp(32px,5vw,56px)}
.parts{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}
.part{border-radius:28px;padding:28px;border:3px solid var(--ink)}
.part-lemon{background:var(--lemon)}.part-mint{background:var(--mint)}.part-blush{background:var(--blush)}
.part-icon{display:inline-block;width:56px;height:56px;margin-bottom:18px}.part-icon :global(svg){width:56px;height:56px}
.part h3{font-size:1.5rem;margin:0 0 16px;line-height:1.1}.part-n{color:var(--blue)}
.part ul{margin:0;padding:0;list-style:none}.part li{padding:10px 0;border-top:2px solid rgba(22,22,22,.18);font-size:1rem;line-height:1.45}
@media(max-width:860px){.parts{grid-template-columns:1fr}}
</style>
