---
import { projects } from '../projects';
---
<section id="lab" class="section lab" aria-labelledby="lab-title">
  <div class="wrap">
    <div class="section-head">
      <div><span class="rule-num">05 · Background processes</span><h2 id="lab-title">AI systems I build on my own time.</h2></div>
      <p>Independent of IBM, built and run on my own hardware. Agent workflows, local inference, automated production, and API integration. Each one teaches me something about the server underneath it.</p>
    </div>
    <table class="procs">
      <caption class="mono">Process table, as of October 2026. Modes describe how each system runs.</caption>
      <colgroup><col class="c-pid"/><col class="c-name"/><col class="c-mode"/><col class="c-desc"/><col class="c-parts"/></colgroup>
      <thead><tr><th scope="col">PID</th><th scope="col">Name</th><th scope="col">Mode</th><th scope="col">What it does</th><th scope="col">Components</th></tr></thead>
      <tbody>
        {projects.map(project => <tr id={project.id}>
          <td data-label="PID" class="mono pid">{project.pid}</td>
          <th scope="row" data-label="Name"><span class="pname">{project.name}</span><span class="ptype mono">{project.type}</span></th>
          <td data-label="Mode"><span class="chip">{project.mode}</span></td>
          <td data-label="What it does" class="desc"><p>{project.description}</p><p class="note">{project.note}</p></td>
          <td data-label="Components"><ul class="parts">{project.components.map(part => <li class="mono">{part}</li>)}</ul></td>
        </tr>)}
      </tbody>
    </table>
  </div>
</section>
<style>
.procs{width:100%;border-collapse:collapse;border-top:1px solid var(--ink);table-layout:fixed}
.c-pid{width:7%}.c-name{width:19%}.c-mode{width:13%}.c-desc{width:auto}.c-parts{width:19%}
.procs .chip{white-space:nowrap}
caption{text-align:left;color:var(--ink-2);padding:0 0 14px;caption-side:top}
thead th{font-family:var(--mono);font-size:.75rem;text-transform:uppercase;letter-spacing:.1em;color:var(--ink-2);text-align:left;font-weight:500;padding:12px 16px 12px 0;border-bottom:1px solid var(--ink)}
tbody td,tbody th{vertical-align:top;padding:22px 16px 22px 0;border-bottom:1px solid var(--line);text-align:left;font-weight:400}
.pid{color:var(--accent)}
.pname{display:block;font-family:var(--serif);font-size:1.5rem;line-height:1.1;font-variation-settings:var(--wonk);font-weight:500;margin-bottom:6px}
.ptype{display:block;color:var(--ink-2)}
.desc{max-width:52ch}.desc p{margin:0 0 10px;font-size:1rem}.desc .note{color:var(--ink-2);font-size:.9375rem;margin:0}
.parts{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:6px}
.parts li{position:relative;padding-left:16px;color:var(--ink-2)}.parts li::before{content:'';position:absolute;left:0;top:.55em;width:7px;height:7px;background:var(--accent-fill)}
.parts li+li::after{content:'';position:absolute;left:3px;top:-6px;height:6px;border-left:1px solid var(--line-2)}
@media(max-width:800px){
  .procs{table-layout:auto}colgroup{display:none}.procs .chip{white-space:normal}
  thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
  .procs,caption,tbody,tr,td,tbody th{display:block}
  caption{width:100%}
  tr{border-bottom:1px solid var(--ink);padding:18px 0}
  tbody td,tbody th{border:0;padding:6px 0}
  td::before,tbody th::before{content:attr(data-label);display:block;font-family:var(--mono);font-size:.7rem;text-transform:uppercase;letter-spacing:.1em;color:var(--ink-2);margin-bottom:4px}
  .pid{display:none}
}
@media print{.procs{font-size:9pt}.pname{font-size:13pt}.desc p{font-size:9pt}tbody td,tbody th{padding:8pt 8pt 8pt 0}}
</style>
