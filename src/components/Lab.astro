---
import { projects } from '../projects';
import ProjectEvidence from './ProjectEvidence.astro';
---
<section id="lab" class="lab wrap" aria-labelledby="lab-title">
  <div class="section-head"><div><p class="kicker">Independent technical work</p><h2 id="lab-title">AI systems I build.</h2></div><p>Private projects built independently on my own time. Agent workflows, local inference, API integration, and automated production.</p></div>
  <div class="projects">{projects.map((project,index)=><article id={project.id}>
    <p class="project-type"><span>{String(index+1).padStart(2,'0')}</span>{project.type}</p>
    <h3>{project.name}</h3><p class="description">{project.description}</p>
    <ul class="tags" aria-label={`${project.name} capabilities`}>{project.tags.map(tag=><li>{tag}</li>)}</ul>
    <ProjectEvidence project={project}/>
  </article>)}</div>
</section>
<style>
.lab{padding-block:88px}.projects{display:grid;grid-template-columns:1fr 1fr;column-gap:48px;row-gap:38px}.projects>article{border-top:3px solid var(--type);padding-top:22px;min-width:0}.project-type{font-size:.875rem;font-weight:750;color:var(--type-2);display:flex;gap:14px;margin-bottom:16px}.project-type span{color:var(--accent)}h3{font-size:1.8rem;margin-bottom:14px}.description{color:var(--type-2);font-size:1rem;min-height:5em}.tags{list-style:none;display:flex;flex-wrap:wrap;gap:7px;margin:0 0 24px;padding:0}.tags li{font-size:.875rem;padding:3px 9px;border:1px solid #c8c8d5;color:var(--type-2)}
@media(max-width:700px){.lab{padding-block:60px}.projects{grid-template-columns:1fr;gap:30px}.description{min-height:0}}
</style>
