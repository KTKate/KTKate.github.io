---
import { numbers } from '../site';
---
<section class="band nums" aria-labelledby="nums-title">
  <div class="wrap">
    <h2 id="nums-title">Numbers that exist.</h2>
    <p class="lede">I do not have adoption or revenue figures I am allowed to publish, so there is no stat wall here. These are the counts that come from employment records, team records, and IBM’s own assessments.</p>
    <ul class="board" aria-label="Counts">
      {numbers.map(n => <li><span class={`sticker big ${n.color}`} style={`--tilt:${n.tilt}`}><strong>{n.big}</strong><span>{n.small}</span></span></li>)}
    </ul>
  </div>
</section>
<style>
.nums h2{margin-bottom:12px}.nums .lede{margin-bottom:clamp(32px,5vw,56px)}
.board{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:28px 22px}
.sticker.big{display:flex;flex-direction:column;gap:8px;border-radius:24px;padding:22px 22px 24px;height:100%;width:100%;transform:rotate(var(--tilt));box-shadow:3px 4px 0 var(--ink)}
.sticker.big strong{font-size:clamp(2.6rem,4.4vw,4rem);line-height:.95;letter-spacing:-.03em;font-variation-settings:"opsz" 96}
.sticker.big span{font-weight:500;font-size:.98rem;line-height:1.35}
.sticker.white{background:var(--white)}
@media(max-width:1000px){.board{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:480px){.board{grid-template-columns:1fr;gap:22px}.sticker.big{transform:rotate(calc(var(--tilt) / 2))}}
</style>
