---
import site, { spec } from '../site';
---
<section class="sheet wrap" aria-labelledby="sheet-title">
  <p class="sheet-meta"><span>Specification sheet</span><span>Rev. {site.revision}</span><span>Part no. {site.partNumber}</span></p>
  <h1 id="sheet-title">Kate<br/>Terraccino<span class="dot" aria-hidden="true">.</span></h1>
  <dl class="spec">
    {spec.map(row => <div><dt>{row.term}</dt><dd>{row.detail}</dd></div>)}
  </dl>
  <div class="sheet-actions">
    <a class="button" href="#work">Selected work <span aria-hidden="true">↓</span></a>
    <a class="button quiet" href={`${import.meta.env.BASE_URL}about/`}>Changelog and background</a>
  </div>
</section>
<style>
.sheet{padding-top:clamp(28px,5vw,64px);padding-bottom:clamp(40px,6vw,80px);position:relative;z-index:1}
.sheet-meta{display:flex;flex-wrap:wrap;gap:6px 0;font-family:var(--mono);font-size:.8125rem;text-transform:uppercase;letter-spacing:.1em;color:var(--ink-2);margin:0 0 22px}
.sheet-meta span{padding-right:14px;margin-right:14px;border-right:1px solid var(--line-2)}.sheet-meta span:last-child{border:0;margin:0;padding:0}
h1{font-size:clamp(3.4rem,13vw,10.5rem);line-height:.9;letter-spacing:-.04em;margin:0 0 clamp(28px,4vw,48px);font-weight:450;font-variation-settings:"SOFT" 100,"WONK" 1,"opsz" 144}
.dot{color:var(--accent)}
.spec{margin:0;display:grid;grid-template-columns:1fr 1fr;column-gap:56px;border-top:1px solid var(--ink)}
.spec div{display:grid;grid-template-columns:150px 1fr;gap:18px;padding:14px 0;border-bottom:1px solid var(--line);align-content:start}
.spec dt{font-family:var(--mono);font-size:.8125rem;text-transform:uppercase;letter-spacing:.08em;color:var(--ink-2);padding-top:5px;display:flex;align-items:baseline;gap:8px}
.spec dt::after{content:'';flex:1;min-width:12px;border-bottom:1px dotted var(--line-2);transform:translateY(-.3em)}
.spec dd{margin:0;font-size:1rem;line-height:1.55}
.sheet-actions{display:flex;flex-wrap:wrap;gap:14px;margin-top:clamp(28px,4vw,44px)}
@media(max-width:900px){.spec{grid-template-columns:1fr}}
@media(max-width:520px){.spec div{grid-template-columns:1fr;gap:4px}.spec dt::after{display:none}h1{font-size:clamp(3rem,16vw,5rem)}}
@media print{.sheet-actions{display:none}}
</style>
