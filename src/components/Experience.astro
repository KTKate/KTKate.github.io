---
import { experience } from '../site';
---
<section class="changelog" aria-labelledby="changelog-title">
  <span class="rule-num">Changelog</span>
  <h2 id="changelog-title">Release history, newest first.</h2>
  <p class="intro">Each entry is a role. The bullets are what changed because I was in it.</p>
  <ol>
    {experience.map(item => <li>
      <div class="ver"><span class="mono">v{item.version}</span><span class="period mono">{item.period}</span></div>
      <div class="role">
        <h3>{item.role}</h3>
        <p class="area mono">{item.area}</p>
        <ul>{item.changes.map(([kind, text]) => <li><span class={`kind kind-${kind.toLowerCase().replace(/\s+/g,'-')}`}>{kind}</span><span>{text}</span></li>)}</ul>
      </div>
    </li>)}
  </ol>
</section>
<style>
.changelog h2{margin-bottom:10px}.intro{color:var(--ink-2);margin-bottom:28px}
.changelog>ol{list-style:none;margin:0;padding:0;border-top:1px solid var(--ink)}
.changelog>ol>li{display:grid;grid-template-columns:150px 1fr;gap:24px;padding:26px 0;border-bottom:1px solid var(--line)}
.ver{display:flex;flex-direction:column;gap:4px}.ver .mono:first-child{color:var(--accent);font-size:1rem}.period{color:var(--ink-2)}
h3{font-size:1.45rem;margin:0 0 4px}.area{color:var(--ink-2);margin:0 0 14px}
.role ul{list-style:none;margin:0;padding:0}
.role li{display:grid;grid-template-columns:110px 1fr;gap:12px;padding:6px 0;max-width:72ch}
.kind{font-family:var(--mono);font-size:.75rem;text-transform:uppercase;letter-spacing:.08em;padding-top:5px;color:var(--ink-2)}
.kind-added{color:#1f6b3a}.kind-shipped{color:var(--accent)}.kind-changed{color:var(--link)}
@media(max-width:600px){.changelog>ol>li{grid-template-columns:1fr;gap:8px}.ver{flex-direction:row;gap:14px}.role li{grid-template-columns:1fr;gap:2px}}
@media print{.changelog>ol>li{display:block;padding:10pt 0;break-inside:avoid}.ver{flex-direction:row;gap:12pt;margin-bottom:4pt}.ver .mono:first-child{font-size:9pt}h3{font-size:12pt}.role li{display:block;font-size:9.5pt;padding:3pt 0}.kind{display:inline-block;margin-right:8pt;padding:0;font-size:7.5pt}}
</style>
