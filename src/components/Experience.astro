---
import { experience } from '../site';
---
<div class="experience">
  <h2>Experience</h2><p class="employer">IBM · October 2015 to present</p>
  <ol>{experience.map(item=><li><p class="period">{item.period}</p><div><h3>{item.role}</h3><p class="area">{item.area}</p><p class="detail">{item.detail}</p></div></li>)}</ol>
  <div class="earlier"><h3>UI developer · Spiceworks</h3><p>Austin, Texas. Before IBM.</p><h3>B.S. in Computer Science and Human Computer Interaction</h3><p>University of Rochester · 2014</p></div>
</div>
<style>
h2{margin-bottom:12px}.employer{font-size:1rem;color:var(--type-2);margin-bottom:28px}ol{padding:0;list-style:none;margin:0}li{display:grid;grid-template-columns:130px 1fr;gap:24px;padding:24px 0;border-top:1px solid var(--line)}.period{font-size:.9375rem;color:var(--type-2);margin:0}h3{font-size:1.25rem;line-height:1.4;letter-spacing:-.025em;margin:0 0 5px}.area{font-size:1rem;font-weight:700;margin:0 0 12px}.detail{font-size:1rem;color:var(--type-2);margin:0;max-width:65ch}.earlier{border-top:1px solid var(--line);padding-top:28px}.earlier p{color:var(--type-2);margin-bottom:24px}.earlier h3{max-width:45ch}
@media(max-width:600px){li{grid-template-columns:1fr;gap:8px}}
@media print{h2{font-size:20pt}h3{font-size:11pt}.detail,.area,.period,.employer,.earlier p{font-size:10pt}li{padding:12pt 0;break-inside:avoid;grid-template-columns:90pt 1fr}.earlier{break-inside:avoid}}
</style>
