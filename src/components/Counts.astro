---
import { counts } from '../site';
---
<section id="counts" class="section counts" aria-labelledby="counts-title">
  <div class="wrap">
    <div class="section-head">
      <div><span class="rule-num">02 · Counts</span><h2 id="counts-title">Numbers I can count, not estimate.</h2></div>
      <p>I do not publish adoption, revenue, or performance figures for the products I work on. Most are restricted until general availability, and the rest belong to the teams that measured them. These counts come from headcount, membership, and release records.</p>
    </div>
    <ol class="ledger">
      {counts.map((item, index) => <li>
        <span class="idx">2.{index + 1}</span>
        <strong><span class="value">{item.value}</span> <span class="unit">{item.unit}</span></strong>
        <span class="what">{item.label}</span>
        <span class="source">Source: {item.source}</span>
      </li>)}
    </ol>
    <p class="legend mono">≈ marks an approximate count.</p>
  </div>
</section>
<style>
.ledger{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0 32px;border-top:1px solid var(--ink)}
.ledger li{display:flex;flex-direction:column;gap:6px;padding:22px 0 26px;border-bottom:1px solid var(--line);position:relative}
.idx{font-family:var(--mono);font-size:.75rem;color:var(--accent);letter-spacing:.08em}
.ledger strong{font-weight:400;display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;line-height:1}
.value{font-family:var(--serif);font-size:clamp(3rem,5vw,4.6rem);letter-spacing:-.04em;font-variation-settings:"SOFT" 100,"WONK" 1,"opsz" 144;color:var(--ink)}
.unit{font-family:var(--mono);font-size:.875rem;text-transform:uppercase;letter-spacing:.08em;color:var(--ink-2)}
.what{font-size:1rem;line-height:1.5;max-width:28ch}
.source{font-family:var(--mono);font-size:.75rem;color:var(--ink-2);margin-top:auto;padding-top:8px}
.legend{color:var(--ink-2);margin:16px 0 0}
@media(max-width:1000px){.ledger{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:480px){.ledger{grid-template-columns:1fr}.ledger li{padding:18px 0}}
@media print{.ledger{grid-template-columns:repeat(4,minmax(0,1fr))}.value{font-size:22pt}.what{font-size:9pt}.source{font-size:7.5pt}}
</style>
