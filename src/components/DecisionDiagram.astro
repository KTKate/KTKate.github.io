---
const { diagram } = Astro.props;
---
<figure class="decision-diagram">
  <figcaption><span class="mono">Sequence</span>{diagram.title}</figcaption>
  <ol>{diagram.steps.map((step, index) => <li><span class="step-number mono">{String(index + 1).padStart(2, '0')}</span><strong>{step.title}</strong><span>{step.detail}</span></li>)}</ol>
  <p>{diagram.caption}</p>
</figure>
<style>
.decision-diagram{margin:36px 0;padding:24px 26px;border:1px solid var(--ink);background:var(--paper);break-inside:avoid;box-shadow:5px 5px 0 var(--paper-3)}
figcaption{font-weight:500;font-size:1.0625rem;margin-bottom:22px;display:flex;gap:14px;align-items:baseline;font-variation-settings:var(--wonk)}figcaption .mono{text-transform:uppercase;letter-spacing:.1em;color:var(--accent)}
ol{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));list-style:none;padding:0;margin:0;gap:28px}
li{position:relative;display:flex;flex-direction:column;gap:6px}
.step-number{color:var(--accent)}
li strong{font-size:1.0625rem;line-height:1.3;font-weight:500}
li>span:last-child{font-size:.9375rem;color:var(--ink-2);line-height:1.5}
li:not(:last-child)::after{content:'→';position:absolute;right:-22px;top:0;color:var(--accent);font-family:var(--mono)}
.decision-diagram>p{font-size:.875rem;line-height:1.6;margin:22px 0 0;color:var(--ink-2);border-top:1px dashed var(--line-2);padding-top:14px}
@media(max-width:600px){.decision-diagram{padding:20px}ol{grid-template-columns:1fr;gap:20px}li:not(:last-child)::after{display:none}li:not(:last-child){border-bottom:1px solid var(--line);padding-bottom:18px}}
@media print{.decision-diagram{padding:12pt;margin:16pt 0;box-shadow:none}ol{grid-template-columns:repeat(3,minmax(0,1fr))}li>span:last-child,.decision-diagram>p{font-size:8.5pt}li strong{font-size:10pt}}
</style>
