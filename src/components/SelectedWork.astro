---
import type { CollectionEntry } from 'astro:content';
interface Props { entries: CollectionEntry<'case-studies'>[] }
const { entries } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<section id="work" class="work wrap" aria-labelledby="work-title">
  <div class="section-head">
    <div><p class="kicker">Product direction and delivery</p><h2 id="work-title">Selected work</h2></div>
    <p>Product decisions, recurring client research, and enterprise delivery. Each account separates my contribution from the team's work.</p>
  </div>
  <ol class="work-list">
    {entries.map((entry, index) => <li>
      <a href={`${base}work/${entry.id}/`} aria-labelledby={`work-${entry.id}-title`}>
        <span class="number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <div class="contribution">
          <p class="category">{entry.data.category}</p>
          <h3 id={`work-${entry.id}-title`}>{entry.data.title}</h3>
          <p class="label">{entry.data.brief?.[1].label || 'Overview'}</p>
          <p class="contribution-copy">{entry.data.brief?.[1].text || entry.data.summary}</p>
        </div>
        <div class="evidence">
          <p class="label">Evidence</p>
          <p class="result">{entry.data.result || 'Development draft'}</p>
          {entry.data.brief && <p class="evidence-copy">{entry.data.brief[2].text}</p>}
          {entry.data.status === 'restricted' && <p class="status">Selected details restricted</p>}
          {entry.data.status === 'draft' && <p class="status">Draft · Development only</p>}
          <span class="read">Read case study <span aria-hidden="true">↗</span></span>
        </div>
      </a>
    </li>)}
  </ol>
</section>
<style>
.work{padding-block:88px}
.work-list{list-style:none;margin:0;padding:0;border-bottom:1px solid var(--line)}
.work-list>li>a{display:grid;grid-template-columns:36px minmax(0,1.35fr) minmax(0,1fr);column-gap:32px;align-items:start;padding:38px 0;border-top:1px solid var(--line);text-decoration:none}
.number{font-size:.9375rem;font-weight:750;color:var(--type-3);padding-top:1px}
.category{font-size:.875rem;color:var(--accent);font-weight:750;margin-bottom:12px}
h3{font-size:clamp(1.65rem,2.4vw,2.2rem);margin:0 0 24px;max-width:26ch}
.label{font-size:.875rem;font-weight:750;color:var(--type-2);margin:0 0 6px}
.contribution-copy,.evidence-copy{color:var(--type-2);font-size:1rem;line-height:1.6;max-width:48ch;margin:0}
.evidence{padding:0 0 0 28px;border-left:3px solid var(--violet);align-self:stretch}
.result{font-size:clamp(1.35rem,2vw,1.75rem);font-weight:750;line-height:1.25;letter-spacing:-.025em;margin:0 0 14px;max-width:24ch;text-wrap:balance}
.status{font-size:.875rem;color:var(--type-2);margin:12px 0 0}
.read{display:inline-flex;align-items:center;gap:12px;min-height:44px;font-size:.9375rem;font-weight:750;margin-top:16px;text-decoration:underline;text-underline-offset:5px}
.read span{font-size:1.4rem}
.work-list a:hover h3{text-decoration:underline;text-underline-offset:6px}
.work-list a:hover .read{color:var(--accent)}
@media(max-width:900px){.work-list>li>a{column-gap:22px;grid-template-columns:26px minmax(0,1.1fr) minmax(0,1fr)}.evidence{padding-left:20px}}
@media(max-width:700px){.work{padding-block:60px}.work-list>li>a{grid-template-columns:24px minmax(0,1fr);gap:24px 14px;padding-block:30px}.evidence{grid-column:2;padding-left:18px}.contribution-copy,.evidence-copy{max-width:54ch}h3{margin-bottom:20px}.result{font-size:1.4rem}.read{margin-top:12px}}
</style>
