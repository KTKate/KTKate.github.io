---
import { paperPanelMasks } from './paperPanelMasks';
const art = `${import.meta.env.BASE_URL}images/paper-panel.webp`;
const sections = ['violet', 'amber', 'magenta'];
---
<figure class="paper-figure" data-paper-figure>
  <svg class="paper-masks" width="0" height="0" aria-hidden="true"><defs>
    {paperPanelMasks.map(mask => <clipPath id={`paper-${mask.name}`} clipPathUnits="objectBoundingBox"><path transform="scale(.0006906077 .0009208103)" d={mask.path} /></clipPath>)}
  </defs></svg>
  <div class="paper-art" role="img" aria-label="Violet design and research, amber product strategy, and magenta technology assemble into one cut-paper panel. Three recessed channels meet at its center." data-paper-art>
    <div class="paper-forms" aria-hidden="true">
      {sections.map(section => <div class={`paper-response ${section}-response`}><img class={`stack ${section}`} src={art} width="1448" height="1086" alt="" decoding="async" fetchpriority={section === 'violet' ? 'high' : 'auto'} /></div>)}
    </div>
  </div>
  <figcaption>
    <div class="disciplines"><span class="design-label">Design &amp; research</span><span class="product-label">Product</span><span class="technology-label">Technology</span></div>
    <svg class="connections" viewBox="0 0 600 64" preserveAspectRatio="none" aria-hidden="true">
      <path class="connection design-line" d="M100 0 V12 L296 43" pathLength="1" />
      <path class="connection product-line" d="M300 0 V43" pathLength="1" />
      <path class="connection technology-line" d="M500 0 V12 L304 43" pathLength="1" />
      <path class="shared-line" d="M300 43 V64" />
    </svg>
    <p class="shared-direction">One product direction.</p>
  </figcaption>
</figure>
<script>
  document.querySelectorAll<HTMLElement>('[data-paper-figure]').forEach(figure => {
    const art = figure.querySelector<HTMLElement>('[data-paper-art]')!;
    const preference = matchMedia('(prefers-reduced-motion: reduce)');
    let visible = false;
    let frame = 0;
    const draw = () => {
      const bounds = art.getBoundingClientRect();
      const start = Math.max(0, scrollY + bounds.top + bounds.height / 2 - innerHeight * .7);
      const distance = Math.min(bounds.height * .4, innerHeight * .24);
      const progress = preference.matches ? 1 : Math.max(0, Math.min(1, (scrollY - start) / distance));
      figure.style.setProperty('--assembly', progress.toFixed(4));
      figure.style.setProperty('--separation', (1 - progress).toFixed(4));
      art.dataset.phase = progress === 1 ? 'joined' : progress === 0 ? 'separate' : 'assembling';
    };
    const schedule = () => {
      if (frame || !visible || preference.matches || document.hidden) return;
      frame = requestAnimationFrame(() => { frame = 0; draw(); });
    };
    const update = () => {
      cancelAnimationFrame(frame);
      frame = 0;
      art.dataset.motion = !preference.matches && visible && !document.hidden ? 'running' : 'static';
      draw();
    };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    preference.addEventListener('change', update);
    document.addEventListener('visibilitychange', update);
    const observer = new IntersectionObserver(entries => {
      visible = entries[0].isIntersecting;
      update();
    }, { threshold: .1 });
    observer.observe(art);
    update();
  });
</script>
<style>
.paper-figure{--assembly:1;--separation:0;margin:0;min-width:0;width:100%}
.paper-art{position:relative;aspect-ratio:4/3;isolation:isolate;overflow:clip}
.paper-forms{position:absolute;inset:3%;pointer-events:none}
.paper-response{position:absolute;inset:0;transform:translate(calc(var(--separation) * var(--from-x)),calc(var(--separation) * var(--from-y))) rotate(calc(var(--separation) * var(--from-angle)));transform-origin:50% 48%}
.violet-response{--from-x:-6%;--from-y:-1.5%;--from-angle:-2deg}
.amber-response{--from-x:6%;--from-y:-1.5%;--from-angle:2deg}
.magenta-response{--from-x:0%;--from-y:8%;--from-angle:0deg}
.stack{position:absolute;inset:0;width:100%;height:100%;object-fit:contain}
.paper-masks{position:absolute;pointer-events:none}.violet{clip-path:url(#paper-violet)}.amber{clip-path:url(#paper-amber)}.magenta{clip-path:url(#paper-magenta)}
figcaption{padding:0 4%;text-align:center}
.disciplines{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;font-size:.875rem;font-weight:700;line-height:1.4}
.design-label{color:#bdb5ff}.product-label{color:#f0a83a}.technology-label{color:#f78ad0}
.connections{display:block;width:100%;height:48px;margin-top:10px;overflow:visible;fill:none;stroke-width:1.5;vector-effect:non-scaling-stroke}
.connection{stroke-linejoin:round}
.design-line{stroke:#bdb5ff}.product-line{stroke:#f0a83a}.technology-line{stroke:#f78ad0}
.shared-line{stroke:#eeeafc}
.shared-direction{margin:9px 0 0;font-size:1rem;font-weight:650;color:#f6f5fd}
@media(max-width:500px){figcaption{padding-inline:0}.disciplines{gap:8px}.shared-direction{font-size:.9375rem}.connections{height:38px}}
@media(prefers-reduced-motion:reduce){.paper-response{transform:none}.connection{stroke-dashoffset:0}.shared-line{opacity:1}}
@media print{.paper-figure{display:none}}
</style>
