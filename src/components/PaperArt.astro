---
const art = `${import.meta.env.BASE_URL}images/paper-convergence.webp`;
---
<figure class="paper-figure" data-paper-figure>
  <div class="paper-art" role="img" aria-label="Three stacks of cut paper: violet for design and research, amber for product, and magenta for technology. Each has dark lower sheets and a light upper surface. Three open channels meet at the center." data-paper-art>
    <div class="paper-forms" aria-hidden="true">
      <img class="stack violet" src={art} width="1254" height="1254" alt="" fetchpriority="high" decoding="async" />
      <img class="stack amber" src={art} width="1254" height="1254" alt="" decoding="async" />
      <img class="stack magenta" src={art} width="1254" height="1254" alt="" decoding="async" />
    </div>
  </div>
  <figcaption>
    <div class="disciplines"><span class="design-label">Design &amp; research</span><span class="product-label">Product</span><span class="technology-label">Technology</span></div>
    <div class="figure-footer"><p>One product direction.</p><button class="motion-control" type="button" data-motion-control hidden><span aria-hidden="true" class="motion-symbol">Ⅱ</span><span data-motion-label>Pause motion</span></button></div>
  </figcaption>
</figure>
<script>
  document.querySelectorAll<HTMLElement>('[data-paper-figure]').forEach(figure => {
    const art = figure.querySelector<HTMLElement>('[data-paper-art]')!;
    const control = figure.querySelector<HTMLButtonElement>('[data-motion-control]')!;
    const label = control.querySelector<HTMLElement>('[data-motion-label]')!;
    const symbol = control.querySelector<HTMLElement>('.motion-symbol')!;
    const preference = matchMedia('(prefers-reduced-motion: reduce)');
    let paused = false;
    let visible = false;
    const update = () => {
      control.hidden = preference.matches;
      art.dataset.motion = !preference.matches && !paused && visible && !document.hidden ? 'running' : 'paused';
      label.textContent = paused ? 'Play motion' : 'Pause motion';
      symbol.textContent = paused ? '▷' : 'Ⅱ';
    };
    control.addEventListener('click', () => { paused = !paused; update(); });
    preference.addEventListener('change', update);
    document.addEventListener('visibilitychange', update);
    const observer = new IntersectionObserver(entries => {
      visible = entries[0].isIntersecting;
      update();
    }, { threshold: 0.1 });
    observer.observe(art);
    update();
  });
</script>
<style>
.paper-figure{margin:0;min-width:0;width:100%}.paper-art{position:relative;aspect-ratio:1;isolation:isolate}.paper-forms{position:absolute;inset:4%;pointer-events:none}.stack{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;animation:converge 10s cubic-bezier(.45,0,.25,1) infinite;animation-play-state:paused;will-change:transform}
.violet{clip-path:polygon(0 0,50% 0,50% 49%,44% 52.5%,10% 72%,0 80%);--dx:-2%;--dy:-1.4%;--turn:-.6deg;transform-origin:35% 40%}.amber{clip-path:polygon(50% 0,100% 0,100% 80%,88% 72%,56% 52%,50% 49%);--dx:2%;--dy:-1.4%;--turn:.6deg;transform-origin:65% 40%}.magenta{clip-path:polygon(0 80%,10% 72%,44% 52.5%,50% 49%,56% 52%,88% 72%,100% 80%,100% 100%,0 100%);--dx:0%;--dy:2.4%;--turn:0deg;transform-origin:50% 72%}
[data-motion=running] .stack{animation-play-state:running}
@keyframes converge{0%,100%{transform:translate(var(--dx),var(--dy)) rotate(var(--turn))}38%,58%{transform:translate(0,0) rotate(0deg)}}
figcaption{padding:10px 4% 0}.disciplines{display:grid;grid-template-columns:1.4fr .7fr 1fr;gap:20px;font-size:.875rem;font-weight:700;line-height:1.5}.disciplines span{border-top:2px solid;padding-top:9px}.design-label{color:#bdb5ff}.product-label{color:#f0a83a}.technology-label{color:#f78ad0}.figure-footer{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-top:18px;min-height:44px}.figure-footer p{font-size:1rem;letter-spacing:-.025em;margin:0;color:#f6f5fd}.motion-control{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:8px 0 8px 12px;border:0;background:none;font-size:.875rem;color:#c9cedf}.motion-control:hover{color:white;text-decoration:underline;text-underline-offset:4px}.motion-symbol{display:inline-block;width:12px;font-size:1rem}
@media(max-width:500px){figcaption{padding-inline:0}.disciplines{gap:12px}.figure-footer{gap:10px}.figure-footer p{font-size:.9375rem}}
@media(prefers-reduced-motion:reduce){.stack{animation:none;will-change:auto;transform:none}.motion-control{display:none}}
@media print{.paper-figure{display:none}}
</style>
