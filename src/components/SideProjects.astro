---
import Scribble from './Scribble.astro';
import { projects } from '../projects';
---
<section id="side" class="band side" aria-labelledby="side-title">
  <div class="wrap">
    <div class="head">
      <h2 id="side-title">Four things running on my own hardware.</h2>
      <p class="lede">Side projects, separate from IBM. They keep my understanding of servers, agents, and APIs current, and one of them makes documentaries.</p>
    </div>
    <ul class="tiles">
      {projects.map(project => <li class="tile" id={project.id}>
        <span class="tile-icon"><Scribble name={project.icon} /></span>
        <span class="tile-kind">{project.kind}</span>
        <h3>{project.name}</h3>
        <p>{project.description}</p>
        <p class="aside">{project.aside}</p>
      </li>)}
    </ul>
  </div>
</section>
<style>
.side{background:var(--mint)}
.head{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:24px 64px;align-items:end;margin-bottom:clamp(32px,5vw,56px)}
.head h2,.head .lede{margin:0}
.tiles{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:24px}
.tile{background:var(--white);border:3px solid var(--ink);border-radius:28px;padding:28px;display:flex;flex-direction:column}
.tile-icon{width:52px;height:52px;margin-bottom:16px}.tile-icon :global(svg){width:52px;height:52px}
.tile-kind{font-weight:650;color:var(--blue);margin-bottom:6px}
.tile h3{margin:0 0 12px;font-size:clamp(1.6rem,2.6vw,2.1rem)}
.tile p{margin:0 0 12px;line-height:1.45}
.aside{margin-top:auto!important;padding-top:14px;border-top:2px dashed var(--ink);color:var(--ink-2);font-size:.98rem}
@media(max-width:860px){.head{grid-template-columns:1fr}.tiles{grid-template-columns:1fr}}
</style>
