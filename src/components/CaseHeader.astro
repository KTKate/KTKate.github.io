---
import Scribble from './Scribble.astro';
import { restrictedNote } from '../site';
const { data, number, tone } = Astro.props;
---
<header class={`case-head tone-${tone}`}>
  <div class="wrap">
    <p class="eyebrow">Case {number} · {data.category}</p>
    <h1>{data.title}</h1>
    <p class="lede">{data.summary}</p>
    <ul class="meta" aria-label="Role, period, and result">
      {data.role && <li><span class="sticker" style="--tilt:-2deg">{data.role}</span></li>}
      {data.timeframe && <li><span class="sticker" style="--tilt:2deg">{data.timeframe}</span></li>}
      {data.result && <li><span class="sticker lemon" style="--tilt:-1deg">{data.result}</span></li>}
    </ul>
  </div>
</header>
<div class="wrap">
  {data.status === 'restricted' && <p class="restriction"><strong>Restriction.</strong> {restrictedNote}</p>}
  {data.brief && <dl class="brief">{data.brief.map(item => <div><dt>{item.label}</dt><dd>{item.text}</dd></div>)}</dl>}
</div>
<style>
.case-head{padding:clamp(36px,6vw,80px) 0 clamp(40px,6vw,72px);border-bottom:3px solid var(--ink)}
.tone-tangerine{background:var(--tangerine)}.tone-lemon{background:var(--lemon)}.tone-blue{background:var(--blue);color:var(--white)}
.tone-blue .eyebrow::before{background:var(--lemon)}.tone-tangerine .eyebrow::before,.tone-lemon .eyebrow::before{background:var(--ink)}
.case-head h1{font-size:clamp(2.4rem,5.6vw,4.8rem);margin:0 0 20px;max-width:16ch}
.case-head .lede{margin-bottom:28px}
.meta{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:16px 14px}
.tone-blue .sticker{color:var(--ink)}
.restriction{margin:32px 0 0;padding:18px 22px;border:3px solid var(--ink);border-radius:18px;background:var(--blush);font-size:1rem}
.brief{margin:28px 0 0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
.brief div{border:3px solid var(--ink);border-radius:22px;padding:20px 22px;background:var(--white)}
.brief dt{font-weight:750;color:var(--blue);margin-bottom:8px;font-size:1.05rem}.brief dd{margin:0;line-height:1.45}
@media(max-width:860px){.brief{grid-template-columns:1fr}}
</style>
