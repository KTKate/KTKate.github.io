---
import Scribble from './Scribble.astro';
import site from '../site';
const base = import.meta.env.BASE_URL;
---
<section class="band hello" aria-labelledby="hello-title">
  <div class="wrap hello-grid">
    <div>
      <Scribble name="smile" class="face" label="A smiling face" />
      <h2 id="hello-title">Hi. I’m Kate.</h2>
    </div>
    <div class="hello-copy">
      <p class="lede">I started as a front-end developer, moved into user research, then into leading design and research teams for the systems behind banks and insurers. Now I set product and platform direction for IBM LinuxONE, and I build AI things on weekends. I live in Southbury, Connecticut.</p>
      <p class="links"><a class="cta" href={`${base}about/`}>The full story <Scribble name="arrow" /></a> <a class="plain" href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>
  </div>
</section>
<style>
.hello{background:var(--lemon);border-top:3px solid var(--ink)}
.hello-grid{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:32px 64px;align-items:center}
:global(.face){width:88px;height:88px;margin-bottom:14px;transform:rotate(-8deg)}
.hello h2{margin:0}
.links{display:flex;flex-wrap:wrap;gap:16px 28px;align-items:center;margin:0}
.plain{font-weight:650}
@media(max-width:860px){.hello-grid{grid-template-columns:1fr}}
</style>
