---
import site from '../site';
const art = `${import.meta.env.BASE_URL}images/paper-stacks.webp`;
---
<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero-grid">
    <div class="copy">
      <p class="kicker">Product and platform direction</p>
      <h1 id="hero-title"><span class="design">Designer <small>and</small><br/>researcher</span><br/><small>and</small> <span class="product">product<br/>strategist</span><br/><small>and</small> <span class="technology">engineer.</span></h1>
      <p class="lede">{site.lede}</p>
      <p class="technical">{site.technical}</p>
      <a class="button" href="#work">Explore selected work <span aria-hidden="true">↓</span></a>
    </div>
    <figure class="paper-figure">
      <div class="paper-art" role="img" aria-label="Three separate stacks of cut paper, violet for design and research, amber for product, and magenta for technology, with three open channels meeting between them.">
        <img class="stack violet" src={art} width="1536" height="1024" alt="" fetchpriority="high" decoding="async" />
        <img class="stack amber" src={art} width="1536" height="1024" alt="" decoding="async" />
        <img class="stack magenta" src={art} width="1536" height="1024" alt="" decoding="async" />
      </div>
      <figcaption><span><i class="violet-key"></i>Design + research</span><span><i class="amber-key"></i>Product</span><span><i class="magenta-key"></i>Technology</span></figcaption>
    </figure>
  </div>
</section>
<style>
.hero{background:var(--navy);color:#fafaf8;padding:48px 0 76px}.hero-grid{display:grid;grid-template-columns:1.03fr 1.1fr;gap:24px;align-items:center}.copy{position:relative;z-index:1}.kicker{color:#c1bbff;margin-bottom:22px}
h1{font-size:clamp(2.8rem,4.5vw,4.25rem);line-height:1.08;margin-bottom:28px;letter-spacing:-.055em}h1 small{font-size:.57em;font-weight:500;letter-spacing:-.03em;color:#fafaf8}.design{color:#beb8ff}.product{color:#f0a83a}.technology{color:#f78ad0}
.lede{font-size:1.1875rem;line-height:1.55;max-width:43ch;margin-bottom:16px}.technical{font-size:1rem;color:#c9cedf;max-width:47ch;margin-bottom:28px}.button{background:var(--amber);color:var(--navy);gap:28px}.button:hover{background:#ffc565}.hero :focus-visible{outline-color:var(--amber)}
.paper-figure{margin:0;min-width:0}.paper-art{position:relative;aspect-ratio:3/2;isolation:isolate}.stack{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;animation:place 1.5s cubic-bezier(.16,1,.3,1) both}.violet{clip-path:polygon(0 0,49% 0,49% 40%,24% 65%,0 67%);--dx:-9px;--dy:-6px}.amber{clip-path:polygon(49% 0,100% 0,100% 68%,78% 66%,49% 40%);--dx:9px;--dy:-6px;animation-delay:.1s}.magenta{clip-path:polygon(0 67%,24% 65%,49% 40%,78% 66%,100% 68%,100% 100%,0 100%);--dx:0px;--dy:9px;animation-delay:.2s}
@keyframes place{from{transform:translate(var(--dx),var(--dy))}to{transform:translate(0,0)}}
figcaption{display:flex;flex-wrap:wrap;justify-content:center;gap:10px 18px;margin-top:26px;font-size:.875rem;color:#d6daea}figcaption span{display:flex;align-items:center;gap:7px}i{width:9px;height:9px;display:inline-block}.violet-key{background:var(--violet)}.amber-key{background:var(--amber)}.magenta-key{background:var(--magenta)}
@media(max-width:900px){.hero-grid{grid-template-columns:1fr;gap:42px}.copy{max-width:620px}.paper-figure{max-width:660px;width:100%;margin-inline:auto}h1{font-size:clamp(2.8rem,7.5vw,4.6rem)}.hero{padding:30px 0 52px}.lede,.technical{max-width:54ch}}
@media(max-width:500px){h1{font-size:clamp(2.3rem,9.8vw,3rem)}.lede{font-size:1.125rem}.hero-grid{gap:34px}figcaption{justify-content:flex-start;gap:8px 16px;margin-top:18px}}
@media print{.hero{background:white;color:var(--type)}.paper-figure,.button{display:none}.hero-grid{display:block}}
</style>
