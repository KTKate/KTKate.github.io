---
import site from '../site';
import PaperArt from './PaperArt.astro';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero-grid">
    <div class="copy">
      <p class="kicker">Product and platform direction</p>
      <h1 id="hero-title"><span class="design">Designer <span class="ampersand">&amp;</span><br/>researcher</span><br/><small>and</small> <span class="product">product<br/>strategist</span><br/><small>and</small> <span class="technology">engineer.</span></h1>
      <p class="lede">{site.lede}</p>
      <p class="technical">{site.technical}</p>
      <a class="button" href="#work">Explore selected work <span aria-hidden="true">↓</span></a>
    </div>
    <PaperArt />
  </div>
</section>
<style>
.hero{background:var(--navy);color:#fafaf8;padding:42px 0 66px}.hero-grid{display:grid;grid-template-columns:1fr 1.2fr;gap:24px;align-items:center}.copy{position:relative;z-index:1}.kicker{color:#c1bbff;margin-bottom:22px}
h1{font-size:clamp(2.8rem,4.5vw,4.25rem);line-height:1.08;margin-bottom:28px;letter-spacing:-.055em}h1 small{font-size:.57em;font-weight:500;letter-spacing:-.03em;color:#fafaf8}.ampersand{font-size:.78em;letter-spacing:-.06em}.design{color:#beb8ff}.product{color:#f0a83a}.technology{color:#f78ad0}
.lede{font-size:1.1875rem;line-height:1.55;max-width:43ch;margin-bottom:16px}.technical{font-size:1rem;color:#c9cedf;max-width:47ch;margin-bottom:28px}.button{background:var(--amber);color:var(--navy);gap:28px}.button:hover{background:#ffc565}.hero :focus-visible{outline-color:var(--amber)}
@media(max-width:700px){.hero-grid{grid-template-columns:1fr;gap:32px}.copy{max-width:620px}.hero-grid :global(.paper-figure){max-width:620px;margin-inline:auto}h1{font-size:clamp(2.8rem,7.5vw,4.6rem)}.hero{padding:30px 0 52px}.lede,.technical{max-width:54ch}}
@media(max-width:500px){h1{font-size:clamp(2.3rem,9.8vw,3rem)}.lede{font-size:1.125rem}.hero-grid{gap:26px}}
@media print{.hero{background:white;color:var(--type)}.button{display:none}.hero-grid{display:block}}
</style>
