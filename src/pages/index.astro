---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Principles from '../components/Principles.astro';
import Lab from '../components/Lab.astro';
import SelectedWork from '../components/SelectedWork.astro';
const entries = (await getCollection('case-studies', e => import.meta.env.DEV || e.data.status !== 'draft')).sort((a,b)=>a.data.order-b.data.order);
---
<Base>
  <Hero />
  <section class="evidence-strip" aria-label="Selected experience"><div class="wrap evidence-grid"><p><strong>4</strong><span>Hybrid cloud products<br/>to general availability</span></p><p><strong>0 → 6</strong><span>LinuxONE design<br/>and research practice</span></p><p><strong>≈30</strong><span>Clients in the<br/>LinuxONE council</span></p></div></section>
  <SelectedWork entries={entries} />
  <Principles />
  <Lab />
</Base>
<style>
.evidence-strip{background:#efeff2;border-bottom:1px solid var(--line)}.evidence-grid{display:grid;grid-template-columns:repeat(3,1fr);padding-block:30px}.evidence-grid p{display:flex;align-items:center;gap:18px;margin:0;padding:0 25px;border-right:1px solid #c7c9d3}.evidence-grid p:first-child{padding-left:0}.evidence-grid p:last-child{border:0}.evidence-grid strong{font-size:2.5rem;letter-spacing:-.06em;white-space:normal;line-height:1.2}.evidence-grid span{font-size:.875rem;line-height:1.5;color:var(--type-2)}@media(max-width:1000px){.evidence-grid p{display:block}.evidence-grid strong{display:block;margin-bottom:6px}}
@media(max-width:700px){.evidence-grid{gap:20px;padding-block:24px}.evidence-grid p{padding:0 10px 0 0}.evidence-grid strong{font-size:1.85rem}.evidence-grid span{font-size:.875rem}.evidence-grid br{display:none}}
@media(max-width:500px){.evidence-grid{grid-template-columns:1fr;gap:18px}.evidence-grid p{display:flex;border:0;gap:18px}.evidence-grid strong{min-width:90px;margin:0}.evidence-grid span{max-width:22ch}}
</style>
