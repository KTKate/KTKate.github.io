---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Principles from '../components/Principles.astro';
import Lab from '../components/Lab.astro';
const base = import.meta.env.BASE_URL;
const entries = (await getCollection('case-studies', (e) => import.meta.env.DEV || e.data.status !== 'draft'))
  .sort((a, b) => a.data.order - b.data.order);
---
<Base>
  <Hero />
  <section id="work" class="work">
    <h2>Selected work</h2>
    <ul>
      {entries.map((e) => (
        <li>
          <a href={`${base}work/${e.id}/`}>
            <span class="t">{e.data.title}</span>
            <span class="s">{e.data.summary}</span>
            {e.data.status === 'draft' && <span class="badge">draft · dev only</span>}
          </a>
        </li>
      ))}
    </ul>
  </section>
  <Principles />
  <Lab />
</Base>

<style>
.work{max-width:1200px;margin:0 auto;padding:96px 40px 0}
h2{font-size:clamp(1.7rem,3vw,2.4rem);margin:0 0 24px}
ul{list-style:none;margin:0;padding:0}
li a{display:block;padding:22px 0;border-top:1px solid var(--line);text-decoration:none;color:var(--type)}
li:last-child a{border-bottom:1px solid var(--line)}
li a:hover .t{color:var(--accent)}
.t{display:block;font-family:var(--display);font-size:1.5rem}
.s{display:block;color:var(--type-2);margin-top:4px}
.badge{display:inline-block;margin-top:8px;font-size:.75rem;color:var(--type-3);border:1px solid var(--line);border-radius:999px;padding:2px 10px}
</style>
