---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Cover from '../components/Cover.astro';
import Stories from '../components/Stories.astro';
import Job from '../components/Job.astro';
import SideProjects from '../components/SideProjects.astro';
import Numbers from '../components/Numbers.astro';
import Hello from '../components/Hello.astro';
const entries = (await getCollection('case-studies', e => import.meta.env.DEV || e.data.status !== 'draft')).sort((a, b) => a.data.order - b.data.order);
---
<Base>
  <Cover />
  <Stories entries={entries} />
  <Job />
  <SideProjects />
  <Numbers />
  <Hello />
</Base>
