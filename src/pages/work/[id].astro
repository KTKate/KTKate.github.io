---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CaseHeader from '../../components/CaseHeader.astro';
import DecisionDiagram from '../../components/DecisionDiagram.astro';
import Scribble from '../../components/Scribble.astro';
import '../../styles/case-study.css';
export async function getStaticPaths() {
  const entries = (await getCollection('case-studies', e => import.meta.env.DEV || e.data.status !== 'draft')).sort((a, b) => a.data.order - b.data.order);
  return entries.map((entry, index) => ({ params: { id: entry.id }, props: { entry, number: index + 1, next: entries[(index + 1) % entries.length] } }));
}
const { entry, number, next } = Astro.props;
const { Content, headings } = await render(entry);
const base = import.meta.env.BASE_URL;
---
<Base title={entry.data.title} description={entry.data.summary}>
  <article class="case wrap">
    {entry.data.status === 'draft' && <p class="draft-note">Development draft. Not published.</p>}
    <CaseHeader data={entry.data} number={number} />
    {entry.data.diagram && <DecisionDiagram diagram={entry.data.diagram} />}
    <div class="case-layout">
      <nav class="contents" aria-label="In this case study"><p>In this case</p>{headings.filter(h => h.depth === 2).map(h => <a href={`#${h.slug}`}>{h.text}</a>)}</nav>
      <div class="case-body"><Content /></div>
    </div>
    <nav class="case-next" aria-label="Next case study">
      <span class="kicker">Next</span>
      <a href={`${base}work/${next.id}/`}>{next.data.title} <Scribble name="arrow" class="next-arrow" /></a>
      <a class="all" href={`${base}#work`}>All four</a>
    </nav>
  </article>
</Base>
