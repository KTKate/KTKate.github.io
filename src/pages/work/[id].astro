---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CaseHeader from '../../components/CaseHeader.astro';
import DecisionDiagram from '../../components/DecisionDiagram.astro';
import '../../styles/case-study.css';
export async function getStaticPaths() {
  const entries = await getCollection('case-studies', e => import.meta.env.DEV || e.data.status !== 'draft');
  return entries.map(entry => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const base = import.meta.env.BASE_URL;
---
<Base title={entry.data.title} description={entry.data.summary}>
  <article class="case-page wrap">
    <a class="back" href={`${base}#work`}>← Selected work</a>
    {entry.data.status === 'draft' && <p class="restriction">Development draft. Not published.</p>}
    <CaseHeader data={entry.data} />
    {entry.data.diagram && <DecisionDiagram diagram={entry.data.diagram} />}
    <div class="case-layout">
      <nav class="contents" aria-label="In this case study"><p>In this case study</p>{headings.filter(h => h.depth === 2).map(h => <a href={`#${h.slug}`}>{h.text}</a>)}</nav>
      <div class="case-body"><Content /></div>
    </div>
    <a class="back end-link" href={`${base}#work`}>← All selected work</a>
  </article>
</Base>
