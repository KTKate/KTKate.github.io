---
import { getCollection, render } from 'astro:content';
import site, { spec, counts } from '../site';
import { principles } from '../principles';
import { projects } from '../projects';
import CaseHeader from '../components/CaseHeader.astro';
import DecisionDiagram from '../components/DecisionDiagram.astro';
import Experience from '../components/Experience.astro';
import '../styles/tokens.css';
import '../styles/case-study.css';
import '../styles/print.css';
const all = (await getCollection('case-studies')).sort((a, b) => a.data.order - b.data.order);
const published = all.filter(e => e.data.status !== 'draft');
const rendered = await Promise.all(published.map(async (e, index) => ({ e, number: String(index + 1).padStart(2, '0'), Content: (await render(e)).Content })));
const drafts = all.filter(e => e.data.status === 'draft');
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex"/><link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml"/><title>{site.name} · Portfolio</title></head>
<body class="print-document">
  <nav class="print-nav mono" aria-label="Document"><a href={import.meta.env.BASE_URL}>Portfolio home</a><a href={`${import.meta.env.BASE_URL}portfolio.pdf`}>Download PDF</a></nav>
  <main>
    <section class="cover">
      <p class="mono meta">Portfolio · Rev. {site.revision} · Part no. {site.partNumber}</p>
      <h1>{site.name}</h1>
      <p class="positioning">{site.positioning}</p>
      <dl class="spec">{spec.map(row => <div><dt>{row.term}</dt><dd>{row.detail}</dd></div>)}</dl>
      <p class="contact"><a href={`mailto:${site.email}`}>{site.email}</a> · <a href={site.linkedin}>{site.linkedin}</a></p>
      <h2>Selected work</h2><ol>{rendered.map(({ e }) => <li>{e.data.title}</li>)}</ol>
      {drafts.length > 0 && <aside class="drafts"><strong>In development</strong>{drafts.map(e => <p>{e.data.title} (draft)</p>)}</aside>}
    </section>
    <section class="entry counts-print">
      <h1>Counts</h1>
      <p>I do not publish adoption, revenue, or performance figures for the products I work on. These counts come from headcount, membership, and release records. ≈ marks an approximate count.</p>
      <dl class="counts">{counts.map(item => <div><dt>{item.value} {item.unit}</dt><dd>{item.label}. <span class="mono">Source: {item.source}</span></dd></div>)}</dl>
      <Experience />
    </section>
    {rendered.map(({ e, number, Content }) => <section class="entry"><CaseHeader data={e.data} number={number} />{e.data.diagram && <DecisionDiagram diagram={e.data.diagram} />}<div class="case-body"><Content /></div></section>)}
    <section class="entry principles-print"><h1>Operating rules</h1>{principles.map(group => <div class="principle-group"><h2><span class="mono">{group.number}</span> {group.name}</h2>{group.items.map(([title, detail]) => <p><strong>{title}</strong><br/>{detail}</p>)}</div>)}</section>
    <section class="entry"><h1>Background processes</h1><p>AI systems built and run independently on my own time and hardware, separate from IBM.</p>{projects.map(project => <article class="print-project"><h2>{project.name} <span class="mono">· {project.mode}</span></h2><p>{project.description}</p><p class="note">{project.note}</p><p class="mono parts">{project.components.join(' → ')}</p></article>)}</section>
  </main>
</body>
</html>
