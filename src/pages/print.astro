---
import { getCollection, render } from 'astro:content';
import site from '../site';
import { principles } from '../principles';
import { projects } from '../projects';
import CaseHeader from '../components/CaseHeader.astro';
import DecisionDiagram from '../components/DecisionDiagram.astro';
import Experience from '../components/Experience.astro';
import ProjectEvidence from '../components/ProjectEvidence.astro';
import '../styles/tokens.css';
import '../styles/case-study.css';
import '../styles/print.css';
const all = (await getCollection('case-studies')).sort((a,b)=>a.data.order-b.data.order);
const rendered = await Promise.all(all.filter(e=>e.data.status!=='draft').map(async e=>({e,Content:(await render(e)).Content})));
const drafts = all.filter(e=>e.data.status==='draft');
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex"/><title>{site.name} · Portfolio</title></head>
<body class="print-document">
  <nav class="print-nav" aria-label="Document"><a href={import.meta.env.BASE_URL}>Portfolio home</a><a href={`${import.meta.env.BASE_URL}portfolio.pdf`}>Download PDF</a></nav>
  <main>
    <section class="cover"><p class="kicker">Portfolio</p><h1>{site.name}</h1><p class="positioning">{site.positioning}</p><p>{site.lede}</p><p>{site.technical}</p><p>{site.location}</p><p><a href={`mailto:${site.email}`}>{site.email}</a><br/><a href={site.linkedin}>{site.linkedin}</a></p>
      <h2>Selected work</h2><ol>{rendered.map(({e})=><li>{e.data.title}</li>)}</ol>
      {drafts.length>0 && <aside class="drafts"><strong>In development</strong>{drafts.map(e=><p>{e.data.title} (draft)</p>)}</aside>}
    </section>
    <section class="entry"><Experience /></section>
    {rendered.map(({e,Content})=><section class="entry"><CaseHeader data={e.data}/>{e.data.diagram&&<DecisionDiagram diagram={e.data.diagram}/>}<div class="case-body"><Content/></div></section>)}
    <section class="entry principles-print"><h1>Product principles</h1>{principles.map(group=><div class="principle-group"><h2>{group.name}</h2>{group.items.map(([title,detail])=><p><strong>{title}</strong><br/>{detail}</p>)}</div>)}</section>
    <section class="entry"><h1>Independent AI systems</h1><p>Private projects built independently on my own time.</p>{projects.map(project=><article class="print-project"><h2>{project.name}</h2><p>{project.description}</p><ProjectEvidence project={project} print/></article>)}</section>
  </main>
</body>
</html>
