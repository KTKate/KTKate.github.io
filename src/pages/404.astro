---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---
<Base title="Not found">
  <section class="nf">
    <h1>Not found</h1>
    <p>That page does not exist. <a href={base}>Back to the work.</a></p>
  </section>
</Base>
<style>
.nf{max-width:760px;margin:0 auto;padding:96px 40px}
h1{font-size:2.4rem;margin:0 0 12px}
a{color:var(--accent)}
</style>
