---
import Base from '../layouts/Base.astro';
import Scribble from '../components/Scribble.astro';
const base = import.meta.env.BASE_URL;
---
<Base title="Not found">
  <section class="nf wrap">
    <span class="kicker">404</span>
    <h1>Nothing at this address.</h1>
    <p class="lede">The page moved or never existed.</p>
    <a class="cta" href={base}>Back to the work <Scribble name="arrow" /></a>
  </section>
</Base>
<style>
.nf{max-width:760px;padding-top:64px;padding-bottom:64px}
h1{margin:0 0 14px}
</style>
