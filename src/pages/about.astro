---
import Base from '../layouts/Base.astro';
import Experience from '../components/Experience.astro';
import site from '../site';
---
<Base title="About" description="Kate Terraccino leads product and platform direction through design, research, and technical evaluation for enterprise infrastructure.">
  <div class="about wrap">
    <section class="about-intro"><p class="kicker">About Kate</p><h1>Product direction informed by research and technical depth.</h1><p class="lead">I am a senior design and research lead at IBM for LinuxONE and Linux on Z. I lead product and platform strategy, client research, and the organizational work needed to move a technical product from proposal to delivery.</p><p>My technical range includes APIs, virtualization, containers, virtual machines, networking, storage, hybrid cloud patterns, and server hardware. I use that knowledge to evaluate implementation options with engineering.</p><p>I build independent AI and automation systems on my own time. Those projects also develop my understanding of hardware and server internals.</p><p>My career began in front-end development. My current work focuses on product decisions: what to build, how to establish feasibility, and how to organize delivery.</p></section>
    <Experience />
    <p class="location">{site.location}. <a href={site.linkedin}>LinkedIn profile</a></p>
  </div>
</Base>
<style>
.about{max-width:1050px;padding-top:56px;padding-bottom:72px}.about-intro{margin-bottom:60px}.about-intro h1{max-width:17ch;margin-bottom:30px}.about-intro p:not(.kicker){max-width:65ch;color:var(--type-2);font-size:1.0625rem;line-height:1.7}.about-intro .lead{font-size:1.3rem!important;color:var(--type)!important}.location{margin:40px 0 0;color:var(--type-2)}
@media(max-width:600px){.about{padding-top:36px}.about-intro .lead{font-size:1.125rem!important}}
</style>
