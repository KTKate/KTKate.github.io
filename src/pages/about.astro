---
import Base from '../layouts/Base.astro';
import Timeline from '../components/Timeline.astro';
import Scribble from '../components/Scribble.astro';
import site, { stack } from '../site';
---
<Base title="About" description="Kate Terraccino's career from front-end development at Spiceworks and IBM to leading design, research, and product direction for IBM LinuxONE.">
  <section class="about-head">
    <div class="wrap">
      <p class="eyebrow">About</p>
      <h1>Eleven years at IBM, one degree from Rochester, and a lot of Angular 1.<Scribble name="squiggle" class="scribble" /></h1>
      <p class="lede">I write code, do research, run teams, and decide what gets built. The order I learned those in is below, oldest at the bottom.</p>
    </div>
  </section>
  <div class="wrap about-body">
    <Timeline />
    <section class="stack" aria-labelledby="stack-title">
      <h2 id="stack-title">Things I have shipped code in.</h2>
      <p class="lede">From the Spiceworks and IBM years. Listed so nobody has to guess whether “technical” means slides.</p>
      <ul class="stack-list">{stack.map((item, i) => <li><span class={`sticker ${['lemon','white','mint','blush'][i % 4]}`} style={`--tilt:${(i % 3 - 1) * 3}deg`}>{item}</span></li>)}</ul>
    </section>
    <section class="also" aria-labelledby="also-title">
      <h2 id="also-title">Also true.</h2>
      <ul>
        <li>I live in {site.location}.</li>
        <li>The LinuxONE client council I founded meets virtually through the year and in person once a year. It is not a sales channel.</li>
        <li>I had my team present the Launchpad work and take the credit. I did not keep a record of which decisions were mine. The case study says what I would do differently.</li>
        <li>My first IT job was resolving support tickets at a nursing school.</li>
      </ul>
      <p><a class="cta" href={`mailto:${site.email}`}>Email me <Scribble name="arrow" /></a> <a class="plain" href={site.linkedin}>Or read the LinkedIn version.</a></p>
    </section>
  </div>
</Base>
<style>
.about-head{background:var(--blush);border-bottom:3px solid var(--ink);padding:clamp(36px,6vw,80px) 0 clamp(40px,6vw,72px)}
.about-head h1{font-size:clamp(2.3rem,5vw,4.4rem);max-width:18ch;margin-bottom:22px}
.about-head .lede{margin:0}
.about-body{padding-top:clamp(48px,7vw,88px)}
.stack{margin-top:clamp(48px,7vw,88px)}.stack h2{margin-bottom:12px}
.stack-list{list-style:none;margin:28px 0 0;padding:0;display:flex;flex-wrap:wrap;gap:18px 14px}
.stack-list .sticker{font-size:1.05rem;padding:11px 18px}
.also{margin-top:clamp(48px,7vw,88px)}.also h2{margin-bottom:20px}
.also ul{list-style:none;margin:0 0 32px;padding:0;max-width:62ch}
.also li{padding:14px 0;border-top:2px solid var(--ink);line-height:1.45}
.also p{display:flex;flex-wrap:wrap;gap:16px 28px;align-items:center;margin:0}
.plain{font-weight:650}
</style>
