---
import Base from '../layouts/Base.astro';
import site from '../site';
---
<Base title="About">
  <section class="about">
    <h1>About</h1>
    <p class="para">
      <!-- The sequence, told as a sequence. Edit freely; verify dates. -->
      I started in computer science and human–computer interaction, spent my first
      years building software, then a decade leading design and research for
      enterprise platforms, and now work at the intersection of product strategy,
      design, and the technology underneath it.
    </p>
    <p class="para">
      <!-- Domain paragraph placeholder: why servers and enterprise platforms shaped how you work. -->
      Placeholder: domain paragraph.
    </p>
    <h2>Experience</h2>
    <ul class="timeline">
      <li><b>Senior Design &amp; Research Lead, LinuxONE and Linux on Z</b> — IBM, 2024–present</li>
      <li><b>Senior Design &amp; Research Manager, AIOps on Z</b> — IBM, 2023–2024</li>
      <li><b>Senior Design &amp; Research Manager, z/OS Hybrid Cloud</b> — IBM, 2019–2023</li>
      <li><b>UX Researcher</b> — IBM, 2017–2018</li>
      <li><b>UX Designer &amp; Developer</b> — IBM, 2015–2019</li>
      <li><b>UI Developer</b> — Spiceworks, 2015</li>
      <li><b>B.S. Computer Science and Human Computer Interaction</b> — University of Rochester, 2014</li>
    </ul>
    <p class="para">Based in {site.location}. <a href={site.linkedin}>Full history on LinkedIn.</a></p>
  </section>
</Base>

<style>
.about{max-width:920px;margin:0 auto;padding:48px 40px 120px}
h1{font-size:clamp(2rem,4vw,3rem);margin:0 0 20px}
h2{font-size:1.5rem;margin:2em 0 .6em}
.para{color:var(--type-2);max-width:62ch}
.timeline{list-style:none;margin:0;padding:0}
.timeline li{padding:12px 0;border-top:1px solid var(--line);color:var(--type-2)}
.timeline b{color:var(--type);font-weight:700}
a{color:var(--accent)}
</style>
