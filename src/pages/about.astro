---
import Base from '../layouts/Base.astro';
import Timeline from '../components/Timeline.astro';
import Scribble from '../components/Scribble.astro';
import site, { stack, numbers } from '../site';
---
<Base title="About" description="Kate Terraccino: developer, then researcher, then manager, then product strategist for enterprise infrastructure. The full history, the numbers, and how she works.">
  <section class="head wrap" style="--tone:var(--violet)">
    <span class="kicker" style="color:var(--tone)">About</span>
    <h1>I can run the research, read the code, lead the team, and make the business case.<Scribble name="squiggle" class="under" /></h1>
    <p class="lede">Production front-end code on about five enterprise products. Research programs with about 30 enterprise clients. Teams of up to 18 people. Four products shipped, and one funded from a proposal I built.</p>
  </section>
  <section class="wrap nums" aria-labelledby="nums-title">
    <h2 id="nums-title" class="kicker">By the numbers</h2>
    <dl class="counts">{numbers.map(n => <div><dt>{n.big}</dt><dd>{n.small}</dd></div>)}</dl>
  </section>
  <section class="wrap">
    <Timeline />
  </section>
  <section class="wrap stack" aria-labelledby="stack-title">
    <h2 id="stack-title" class="kicker">I still read and write code</h2>
    <p class="lede">Production front-end work across about five enterprise products, which is why engineering teams let me into the API discussion and why the side projects exist.</p>
    <p class="stack-list">{stack.map((item, i) => <span>{i > 0 && <span class="dot" aria-hidden="true"> · </span>}{item}</span>)}</p>
  </section>
  <section class="wrap also" aria-labelledby="also-title">
    <h2 id="also-title" class="kicker">How I work</h2>
    <ul>
      <li>Research before requirements. An hour with a user saves a quarter of rework, so the client conversation happens before the roadmap is fixed, not after.</li>
      <li>APIs before promises. I read the interfaces and watch the software run before I commit a team to a direction.</li>
      <li>One accountable lead per product, and a manager accountable for the whole. It is how I run teams and how I built two practices from nothing.</li>
      <li>The team presents its own work. Credit goes to the people who did it, and the organization learns who to call.</li>
    </ul>
    <p><a class="cta" href={`mailto:${site.email}`}>Email me <Scribble name="arrow" /></a> <a class="plain" href={site.linkedin}>Or read the LinkedIn version.</a></p>
  </section>
</Base>
<style>
.head{padding-top:clamp(32px,6vw,88px);padding-bottom:clamp(32px,5vw,64px)}
.head h1{margin:0 0 20px;max-width:16em}
:global(.under){display:block;width:220px;color:var(--tone);margin-top:10px}
.head .lede{margin:0}
.nums{padding-bottom:clamp(40px,6vw,80px)}
.counts{margin:28px 0 0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0 32px;border-top:1px solid var(--line)}
.counts div{padding:20px 0 22px;border-bottom:1px solid var(--line)}
.counts dt{font-size:clamp(2.2rem,4vw,3.4rem);font-weight:650;letter-spacing:-.03em;line-height:1;color:var(--accent);font-variation-settings:"opsz" 96;margin-bottom:8px}
.counts dd{margin:0;color:var(--fg-2);font-size:.98rem;line-height:1.4}
.stack{padding-top:clamp(40px,6vw,80px)}
.stack-list{font-size:clamp(1.3rem,2.6vw,2rem);font-weight:600;line-height:1.5;letter-spacing:-.01em;max-width:30em;margin:0}
.dot{color:var(--magenta)}
.also{padding-top:clamp(40px,6vw,80px)}
.also ul{list-style:none;margin:0 0 28px;padding:0;max-width:40em;border-top:1px solid var(--line)}
.also li{padding:16px 0;border-bottom:1px solid var(--line);color:var(--fg-2)}
.also p{display:flex;flex-wrap:wrap;gap:16px 28px;align-items:center;margin:0}
.plain{font-weight:500}
@media(max-width:900px){.counts{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:460px){.counts{grid-template-columns:1fr}}
</style>
