---
import site from '../site';
import '../styles/tokens.css';
const { title, description = site.positioning } = Astro.props;
const base = import.meta.env.BASE_URL;
const about = Astro.url.pathname.endsWith('/about/');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta property="og:title" content={title ? `${title} · ${site.name}` : site.name} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <title>{title ? `${title} · ${site.name}` : `${site.name} · ${site.positioning}`}</title>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="name" href={base}>{site.name}<span>Product · Design · Technology</span></a>
      <nav aria-label="Main"><a href={`${base}#work`}>Work</a><a href={`${base}about/`} aria-current={about ? 'page' : undefined}>About</a><a href={`${base}#lab`}>Lab</a></nav>
    </div>
  </header>
  <main id="main" tabindex="-1"><slot /></main>
  <footer class="wrap">
    <div><p class="footer-name">Kate Terraccino</p><p>{site.location}</p></div>
    <div class="footer-links"><a href={`mailto:${site.email}`}>Email Kate</a><a href={site.linkedin}>LinkedIn</a><a href={`${base}portfolio.pdf`}>Portfolio PDF</a></div>
  </footer>
</body>
</html>
<style>
.site-header{background:var(--navy);color:#fafaf8}.header-inner{min-height:104px;display:flex;justify-content:space-between;align-items:center;gap:24px}
.name{font-weight:800;letter-spacing:-.03em;text-decoration:none;font-size:1.0625rem}.name span{display:block;font-weight:500;font-size:.875rem;letter-spacing:0;color:#bdc2d5;margin-top:2px}
nav{display:flex;gap:28px}nav a{font-size:.9375rem;text-decoration:none;padding:12px 0;min-height:48px}nav a:hover,nav a[aria-current]{text-decoration:underline;text-decoration-color:var(--amber);text-decoration-thickness:2px}.site-header :focus-visible{outline-color:var(--amber)}
.skip{position:fixed;left:16px;top:-100px;background:var(--amber);color:var(--navy);padding:12px 18px;z-index:100}.skip:focus{top:12px}
footer{padding-block:42px;display:flex;justify-content:space-between;gap:30px;border-top:1px solid var(--line);font-size:.9375rem;color:var(--type-2)}footer p{margin:0}.footer-name{color:var(--type);font-weight:800}.footer-links{display:flex;flex-wrap:wrap;gap:24px;align-items:start}.footer-links a{padding:8px 0}
@media(max-width:500px){.header-inner{min-height:120px;display:block;padding-top:20px;padding-bottom:12px}.name span{display:none}nav{gap:26px;margin-top:5px}footer{flex-direction:column;gap:20px}.footer-links{gap:22px}}
@media print{.site-header,footer,.skip{display:none}}
</style>
