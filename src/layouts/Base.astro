---
import site from '../site';
import '../styles/tokens.css';
const { title, description = site.description } = Astro.props;
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const current = (prefix: string) => path.startsWith(`${base}${prefix}`) ? 'page' : undefined;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta property="og:title" content={title ? `${title} · ${site.name}` : site.name} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta name="theme-color" content="#0f1426" />
  <link rel="canonical" href={new URL(path, Astro.site)} />
  <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  <title>{title ? `${title} · ${site.name}` : `${site.name} · ${site.tagline}`}</title>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="top wrap">
    <a class="name" href={base}>Kate Terraccino</a>
    <nav aria-label="Main">
      <a href={`${base}#work`}>Work</a>
      <a href={`${base}side-projects/`} aria-current={current('side-projects/')}>Side projects</a>
      <a href={`${base}about/`} aria-current={current('about/')}>About</a>
      <a href={`mailto:${site.email}`}>Email</a>
    </nav>
  </header>
  <main id="main" tabindex="-1"><slot /></main>
  <footer class="foot wrap">
    <p><a href={`mailto:${site.email}`}>{site.email}</a> · <a href={site.linkedin}>LinkedIn</a></p>
    <p class="muted">{site.location}</p>
  </footer>
</body>
</html>
<style>
.skip{position:fixed;left:16px;top:-100px;background:var(--accent);color:var(--bg);padding:12px 18px;z-index:100;font-weight:600}.skip:focus{top:12px}
.top{display:flex;justify-content:space-between;align-items:center;min-height:88px;gap:20px}
.name{font-weight:650;font-size:1.15rem;text-decoration:none;letter-spacing:-.02em;padding:8px 0}
nav{display:flex;gap:4px;flex-wrap:wrap}
nav a{text-decoration:none;font-weight:500;font-size:1rem;padding:10px 12px;min-height:48px;display:inline-flex;align-items:center;border-bottom:2px solid transparent;color:var(--fg-2)}
nav a:hover{color:var(--accent)}nav a[aria-current]{color:var(--fg);border-bottom-color:var(--accent)}
.foot{margin-top:clamp(72px,10vw,140px);padding-top:28px;padding-bottom:40px;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;font-size:.95rem}
.foot p{margin:0}
@media(max-width:460px){.top{flex-direction:column;align-items:flex-start;gap:0;padding-top:14px}nav{margin-left:-12px}}
</style>
