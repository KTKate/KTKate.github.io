---
import site from '../site';
import '../styles/tokens.css';
const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title ? `${title} · ${site.name}` : `${site.name} · ${site.positioning}`}</title>
  <meta name="description" content={site.positioning} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Manrope:wght@400;500;700;800&display=swap" rel="stylesheet" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header>
    <a class="name" href={base}>{site.name}</a>
    <nav aria-label="Main">
      <a href={base}>Work</a>
      <a href={`${base}#lab`}>Lab</a>
      <a href={`${base}about/`}>About</a>
    </nav>
  </header>
  <main id="main"><slot /></main>
  <footer>
    <a href={`mailto:${site.email}`}>{site.email}</a>
    <a href={site.linkedin}>LinkedIn</a>
    <a href={`${base}portfolio.pdf`}>PDF version</a>
  </footer>
</body>
</html>

<style>
.skip{position:absolute;left:-999px;top:8px;background:var(--accent);color:#141b38;padding:8px 14px;border-radius:4px;z-index:100}
.skip:focus{left:8px}
header{max-width:1200px;margin:0 auto;padding:28px 40px;display:flex;justify-content:space-between;align-items:center;position:relative;z-index:5}
.name{font-weight:800;letter-spacing:-.01em;text-decoration:none;color:var(--type)}
nav a{color:var(--type);opacity:.75;text-decoration:none;font-weight:600;margin-left:28px}
nav a:hover{opacity:1;border-bottom:2px solid var(--accent)}
footer{max-width:1200px;margin:0 auto;padding:32px 40px 48px;border-top:1px solid var(--line);display:flex;gap:28px}
footer a{color:var(--type-2);text-decoration:none}
footer a:hover{color:var(--type)}
:global(:focus-visible){outline:3px solid var(--accent);outline-offset:2px}
@media print{header,footer,.skip{display:none}}
</style>
